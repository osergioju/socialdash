DATABASE_URL="postgresql://user:password@localhost:5432/socialdash"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
# IMPORTANTE: deve incluir /api — usado para montar a URL de callback OAuth
BACKEND_URL="http://localhost:3001/api"

# 32 bytes → node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Meta (Facebook / Instagram)
META_APP_ID=""
META_APP_SECRET=""

# Google Analytics (GA4)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Opcional: sobrescreve os escopos OAuth do LinkedIn (use "openid profile email"
# enquanto o app não tiver a Community Management API aprovada)
LINKEDIN_SCOPES=""
# Versão da API versionada (rest/*). Formato YYYYMM, expira ~12 meses após o
# lançamento — se rest/posts/rest/organizationalEntityShareStatistics começarem
# a dar 426 "version not active", suba este valor pro mês atual.
LINKEDIN_API_VERSION="202608"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
